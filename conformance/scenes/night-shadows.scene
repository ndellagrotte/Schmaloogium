# The shadow pass (§3.4): low moon, a stone pillar/receiver and torch block light.
[scene]
schema = schmaloogium.scene/2
id = night-shadows
description = low-moon landscape with a torch-lit stone receiver and two-block shadow caster
family = shadows
minMilestone = v0.2

[world]

# Pack fixture registry (PHASE_2_DOC §4.10.1, RESEARCH.md App G). Never re-hosted: archives
# live only in the cache root (§4.10.3). [D-P2-20]: MODRINTH rows keep empty pins until the
# implementation populates them; the resolver refuses an unpinned row rather than "latest".
# The Modrinth transport is a named deferral of Task C: a MODRINTH row resolves only from a
# warm cache. MANUAL rows are canonical-download-only; sha512 pins are the verified archives.
# "corpus" rows are the repo-owned GPL micro-packs staged as deterministic zips by
#   ./gradlew :conformance:harness --args="stage-micropacks"

[pack bsl]
displayName = BSL Shaders
tier = dual-spec
mode = MODRINTH
modrinthProject = bsl-shaders
modrinthVersion =
version = 10.1.3
sha512 =
archiveName = BSL_v10.1.3.zip
licence = ARR — no bundling, no re-hosting (RESEARCH.md App G)
sourceUrl = https://modrinth.com/shader/bsl-shaders


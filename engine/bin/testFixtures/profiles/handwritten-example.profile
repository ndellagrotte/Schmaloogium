max.vertexAttribs = 16
renderer = NVIDIA GeForce RTX 3080/PCIe/SSE2
vendor = NVIDIA Corporation
extensions =
  GL_ARB_debug_output
  GL_ARB_sampler_objects
  GL_ARB_texture_rectangle
  GL_KHR_debug

{
  "$schema": "../.agents/skills/verify-loop/schemas/policy.schema.json",
  "version": 1,
  "presets": {
    "lean": {
      "finders": 3,
      "refuters": 2,
      "steelman": false,
      "max_concurrency": 6
    },
    "thorough": {
      "finders": 5,
      "refuters": 3,
      "steelman": true,
      "max_concurrency": 8
    }
  },
  "severity_rank": {
    "none": 0,
    "note": 1,
    "correction": 2,
    "blocking": 3
  },
  "survival": {
    "refuting_majority": "strict",
    "severity_aggregation": "upper-median-non-refuting",
    "interface_aggregation": "strict-majority-non-refuting"
  },
  "verdict": {
    "allowed": [
      "PASS",
      "PASS-WITH-CORRECTIONS",
      "FAIL"
    ],
    "pass_requires_literal": true,
    "pass_blocking_count": 0,
    "pass_correction_count": 0,
    "notes_block_pass": false
  },
  "convergence": {
    "window": 3,
    "corrections_must": "strictly-decrease",
    "addendum_line_cap": 40
  },
  "stop_conditions": [
    "PASS",
    "FAIL",
    "REVIEW_ONLY",
    "ROUND_CAP",
    "AGENT_ERROR",
    "VALIDATION_ERROR"
  ],
  "cost_estimate": {
    "assumed_candidates_per_finder": 2,
    "input_tokens_per_agent": 45000,
    "output_tokens_per_agent": 5000
  }
}

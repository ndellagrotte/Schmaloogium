            "start": "^### Phase 13 — Texture systems$",
            "end": "^### Phase 14 — GL modernization & performance$"
          }
        },
        {
          "id": "doc_gate",
          "selector": {
            "start": "^\\*\\*Doc gate:\\*\\* all three custom-texture forms",
            "end": "^\\*\\*Impl gate:\\*\\*",
            "end_mode": "first-after-start"
          }
        },
        {
          "id": "mandatory_template",
          "selector": {
            "start": "^## G9\\. PHASE_X_DOC\\.md — mandatory template$",
            "end": "^## G10\\. Open-question assignments$"
          }
        }
      ]
    },
    {
      "path": "docs/research/v1/RESEARCH.md",

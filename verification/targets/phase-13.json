        {
          "id": "hooks_catalog",
          "selector": {
            "start": "^## Appendix E — Hooks catalog",
            "end": "^## Appendix F — `shaders\\.properties` key catalog"
          }
        },
        {
          "id": "custom_textures_and_noise",
          "selector": {
            "start": "^### F\\.5 Custom textures and noise$",
            "end": "^### F\\.6 Custom uniforms / variables \\(expression language\\)$"
          }
        },
        {
          "id": "glossary",
          "selector": {
            "start": "^## Appendix H — Glossary"
          }
        }
      ]

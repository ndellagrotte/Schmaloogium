  "prior_reviews": {
    "directory": "docs/phase13/reviews",
    "filename_regex": "^PHASE_13_REVIEW_(?<round>\\d+)\\.md$",
    "round_group": "round",
    "read_order": "adjudicator-last",
    "allow_gaps": false
  },
  "forbidden_sources": {
    "path_patterns": [
      "docs/**/chatlogs/**",
      "*.txt"
    ],
    "provenance_patterns": [
      "any prior agent or session transcript, regardless of path or extension"
    ]
  },
  "immutable_paths": [
    "docs/research/**",
    "docs/design/**",
    "docs/reference/pintonium/v1.0/PINTONIUM_DESIGN.md",
    "docs/phase3/v1/PHASE_3_DOC.md",
    "docs/phase3/reviews/**",
    "docs/phase5/v1/PHASE_5_DOC.md",
    "docs/phase5/reviews/**",
    "docs/phase7/v1/PHASE_7_DOC.md",
    "docs/phase7/reviews/**",
    "docs/phase13/reviews/*.md",
    "reference-src/schlorbium-HD_U_G6_pre1/SHADER_ENGINE_IMPL.md",
    "reference-src/schlorbium-HD_U_G6_pre1/doc/shaders.properties",
    "reference-src/schlorbium-HD_U_G6_pre1/doc/shaders.txt",

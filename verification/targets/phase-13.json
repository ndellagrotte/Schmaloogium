{
  "$schema": "../../.agents/skills/verify-loop/schemas/manifest.schema.json",
  "version": 1,
  "id": "phase-13",
  "title": "Phase 13 — Texture systems",
  "description": "Adversarial verification profile for the current Phase 13 architecture document.",
  "targets": [
    {
      "path": "docs/phase13/v1/PHASE_13_DOC.md",
      "role": "document under review",
      "selectors": [

            "end": "^## 12\\. Annotated index of reference material$"
          }
        },
        {
          "id": "texture_unit_map_and_formats",
          "selector": {
            "start": "^### B\\.3 The fixed texture-unit map \\(packs rely on these numbers\\)$",
            "end": "^### B\\.5 Draw-buffer index prefixes$"

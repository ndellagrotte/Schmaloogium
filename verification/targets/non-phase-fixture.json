{
  "$schema": "../../.agents/skills/verify-loop/schemas/manifest.schema.json",
  "version": 1,
  "id": "non-phase-fixture",
  "title": "Non-phase widget portability fixture",
  "description": "Small test-only target proving that the engine has no phase/document-layout dependency.",
  "targets": [
    {
      "path": "verification/fixtures/non-phase/TARGET.md",
      "role": "target behavior contract",
      "selectors": [
        {
          "id": "public_contract",
          "selector": {
            "start": "^## Public contract$",
            "end": "^## Internal notes$"
          }
        }
      ]
    }
  ],
  "authoritative_sources": [
    {
      "path": "verification/fixtures/non-phase/SPEC.md",
      "role": "authoritative widget specification",
      "selectors": [
        {
          "id": "required_behavior",
          "selector": {
            "start": "^## Required behavior$",
            "end": "^## Completion gate$"
          }
        },
        {
          "id": "completion_gate",
          "selector": {
            "start": "^## Completion gate$"
          }
        }
      ]
    }
  ],
  "supporting_evidence": [
    {
      "path": "verification/fixtures/non-phase/EVIDENCE.md",
      "role": "supporting fixture evidence"
    }
  ],
  "dependencies": [
    {
      "path": "verification/fixtures/non-phase/DEPENDENCY.md",
      "role": "storage dependency",
      "binding_contract": {
        "start": "^## Binding contract$",
        "end": "^## Implementation$"
      }
    }
  ],
  "prior_reviews": {
    "directory": "verification/fixtures/non-phase/reviews",
    "filename_regex": "^REVIEW_(?<round>\\d+)\\.md$",
    "round_group": "round",
    "read_order": "adjudicator-last",
    "allow_gaps": false
  },
  "forbidden_sources": {
    "path_patterns": [
      "docs/**/chatlogs/**",
      "*.txt"
    ],
    "provenance_patterns": [
      "any prior agent or session transcript, regardless of path or extension"
    ]
  },
  "immutable_paths": [
    "verification/fixtures/non-phase/SPEC.md",
    "verification/fixtures/non-phase/DEPENDENCY.md",
    "verification/fixtures/non-phase/EVIDENCE.md",
    "verification/fixtures/non-phase/reviews/*.md"
  ],
  "write_permissions": {
    "adjudicator": [
      "{review_output}"
    ],
    "fixup": [
      "verification/fixtures/non-phase/TARGET.md",
      "{review_output}"
    ]
  },
  "output": {
    "directory": "verification/fixtures/non-phase/reviews",
    "review_template": "REVIEW_{round}.md",
    "journal_directory": ".verification-runs/non-phase-fixture"
  },
  "attack_lenses": "verification/lenses/non-phase.json",
  "lens_order": {
    "first_review": [
      "contract",
      "edge-cases",
      "consistency",
      "dependencies",
      "operability"
    ],
    "mature": [
      "consistency",
      "contract",
      "edge-cases",
      "dependencies",
      "operability"
    ]
  },
  "citation": {
    "format": "repo-relative-line-quote",
    "resolver": "line-quote",
    "allow_unique_relocation": true
  },
  "interface_regions": [
    {
      "id": "public-contract",
      "path": "verification/fixtures/non-phase/TARGET.md",
      "selector": {
        "start": "^## Public contract$",
        "end": "^## Internal notes$"
      },
      "change_trigger": "The fixture must be re-reviewed."
    }
  ],
  "policy": "verification/policy.json",
  "target_context": {
    "fixture_kind": "non-phase behavior contract"
  },
  "fixup_instructions": "Do not add a phase-style addendum. Make only the minimal target correction and record full reasoning in the review's Resolutions."
}

    {
      "path": "reference-src/pintonium-9c2fcc1/COPYING.LESSER",
      "role": "Pintonium root LGPL license material"
    },
    {
      "path": "reference-src/pintonium-9c2fcc1/LICENSE",
      "role": "Pintonium root license notice"
    }
  ],
  "dependencies": [
    {
      "path": "docs/phase1/v14/PHASE_1_DOC.md",
      "role": "dependency architecture and binding interface",
      "binding_contract": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      }
    },
    {
      "path": "docs/phase3/v1/PHASE_3_DOC.md",
      "role": "dependency architecture and binding interface",
      "binding_contract": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      }
    }
  ],
  "prior_reviews": {
    "directory": "docs/phase12/reviews",
    "filename_regex": "^PHASE_12_REVIEW_(?<round>\\d+)\\.md$",
    "round_group": "round",
    "read_order": "adjudicator-last",
    "allow_gaps": false
  },
  "forbidden_sources": {
    "path_patterns": [
      "docs/**/chatlogs/**",
      "*.txt"
    ],
    "provenance_patterns": [
      "any prior agent or session transcript, regardless of path or extension"
    ]
  },
  "immutable_paths": [
    "docs/research/**",
    "docs/design/**",
    "docs/reference/pintonium/v1.0/PINTONIUM_DESIGN.md",
    "docs/phase1/v14/PHASE_1_DOC.md",
    "docs/phase1/reviews/**",
    "docs/phase3/v1/PHASE_3_DOC.md",
    "docs/phase3/reviews/**",
    "docs/phase12/reviews/*.md",
    "reference-src/schlorbium-HD_U_G6_pre1/doc/shaders.properties",
    "reference-src/pintonium-9c2fcc1/forge122/src/shaders/java/net/irisshaders/iris/gui/VintageShaderPackOptionsScreen.java",
    "reference-src/pintonium-9c2fcc1/forge122/src/shaders/java/net/irisshaders/iris/gui/VintageShaderPackSelectionScreen.java",
    "reference-src/pintonium-9c2fcc1/COPYING",
    "reference-src/pintonium-9c2fcc1/COPYING.LESSER",
    "reference-src/pintonium-9c2fcc1/LICENSE"
  ],
  "write_permissions": {
    "adjudicator": [
      "{review_output}"
    ],
    "fixup": [
      "docs/phase12/v1/PHASE_12_DOC.md",
      "{review_output}"
    ]
  },
  "output": {
    "directory": "docs/phase12/reviews",
    "review_template": "PHASE_12_REVIEW_{round}.md",
    "journal_directory": ".verification-runs/phase-12"
  },
  "attack_lenses": "verification/lenses/phase-document.json",
  "lens_order": {
    "first_review": [
      "interfaces",
      "conformance",
      "doc-gate",
      "scope-decisions",
      "new-surface"
    ],
    "mature": [
      "new-surface",
      "interfaces",
      "conformance",
      "doc-gate",
      "scope-decisions"
    ]
  },
  "citation": {
    "format": "repo-relative-line-quote",
    "resolver": "line-quote",
    "allow_unique_relocation": true
  },
  "interface_regions": [
    {
      "id": "cross-phase-interfaces",
      "path": "docs/phase12/v1/PHASE_12_DOC.md",
      "selector": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      },
      "change_trigger": "A fresh verify round is required before Phase 12 can close."
    }
  ],
  "policy": "verification/policy.json",
  "target_context": {
    "assigned_open_questions": "OQ-9",
    "phase_name": "Options GUI, persistence & reload",
    "mandatory_section_count": 13
  },
  "fixup_instructions": "This is a first-version document with no mature fix-up-addendum convention. If a correction changes the target, add only a compact next-numbered §0 subsection using its existing header style; do not import Phase 1's supersession sentences, dated-claim ranges, or session-count bookkeeping. Keep full reasoning in the current review's Resolutions and do not roll the v1 directory during a loop."
}

{
  "$schema": "../../.agents/skills/verify-loop/schemas/manifest.schema.json",
  "version": 1,
  "id": "phase-12",
  "title": "Phase 12 — Options GUI, persistence & reload",
  "description": "Adversarial verification profile for the current Phase 12 architecture document.",
  "targets": [
    {
      "path": "docs/phase12/v1/PHASE_12_DOC.md",
      "role": "document under review",
      "selectors": [
        {
          "id": "whole_document",
          "selector": {
            "start": "^# Schmaloogium — Phase 12:"
          }
        }
      ]
    }
  ],
  "design_revision": {
    "target_index": 0,
    "section_zero": {
      "start": "^## 0\\. Header$",
      "end": "^## 1\\. Scope & boundaries$"
    },
    "declaration_pattern": "^\\*\\*Governing design:\\*\\* `(?<path>docs/design/[A-Za-z0-9._-]+/DESIGN\\.md)`"
  },
  "authoritative_sources": [
    {
      "path": "docs/design/{design_version}/DESIGN.md",
      "role": "governing design revision",
      "selectors": [
        {
          "id": "part_i",
          "selector": {
            "start": "^## Part I — Global sections$",
            "end": "^## Part II — Phase specifications$"
          }
        },
        {
          "id": "target_spec",
          "selector": {
            "start": "^### Phase 12 — Options GUI, persistence & reload$",
            "end": "^### Phase 13 — Texture systems$"
          }
        },
        {
          "id": "doc_gate",
          "selector": {
            "start": "^\\*\\*Doc gate:\\*\\* every App F\\.3/F\\.4 construct in the conformance map",
            "end": "^\\*\\*Impl gate:\\*\\*",
            "end_mode": "first-after-start"
          }
        },
        {
          "id": "mandatory_template",
          "selector": {
            "start": "^## G9\\. PHASE_X_DOC\\.md — mandatory template$",
            "end": "^## G10\\. Open-question assignments$"
          }
        }
      ]
    },
    {
      "path": "docs/research/v1/RESEARCH.md",
      "role": "contract ground truth",
      "selectors": [
        {
          "id": "front_matter_and_mission",
          "selector": {
            "start": "^## 0\\. Front matter$",
            "end": "^## 2\\. Prior art and niche analysis$"
          }
        },
        {
          "id": "options_gui_behavior",
          "selector": {
            "start": "^### 4\\.7 Options, aliases, GUI, failure handling$",
            "end": "^## 5\\. Cleanroom platform facts$"
          }
        },
        {
          "id": "options_gui_direction",
          "selector": {
            "start": "^### 7\\.6 Options GUI$",
            "end": "^## 8\\. Compatibility target and conformance strategy$"
          }
        },
        {
          "id": "milestones",
          "selector": {
            "start": "^## 9\\. Milestones$",
            "end": "^## 10\\. Legal and licensing$"
          }
        },
        {
          "id": "open_question_ledger",
          "selector": {
            "start": "^## 11\\. Open questions and risk register$",
            "end": "^## 12\\. Annotated index of reference material$"
          }
        },
        {
          "id": "hooks_catalog",
          "selector": {
            "start": "^## Appendix E — Hooks catalog",
            "end": "^## Appendix F — `shaders\\.properties` key catalog"
          }
        },
        {
          "id": "options_profiles_screens",
          "selector": {
            "start": "^### F\\.3 Options \\(discovered in sources; properties only organizes them\\)$",
            "end": "^### F\\.5 Custom textures and noise$"
          }
        },
        {
          "id": "glossary",
          "selector": {
            "start": "^## Appendix H — Glossary"
          }
        }
      ]
    }
  ],
  "supporting_evidence": [
    {
      "path": "docs/phase1/reviews/PHASE_1_REVIEW_25.md",
      "role": "latest literal-PASS verification state for the Phase 1 dependency contract"
    },
    {
      "path": "docs/phase3/reviews/PHASE_3_REVIEW_34.md",
      "role": "literal-PASS verification state the target cites for the Phase 3 dependency contract"
    },
    {
      "path": "docs/phase3/reviews/PHASE_3_REVIEW_35.md",
      "role": "later Phase 3 review round — dependency-state evidence"
    },
    {
      "path": "docs/phase3/reviews/PHASE_3_REVIEW_36.md",
      "role": "latest Phase 3 review round — dependency-state evidence"
    },
    {

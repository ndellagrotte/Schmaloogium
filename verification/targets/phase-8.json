{
  "$schema": "../../.agents/skills/verify-loop/schemas/manifest.schema.json",
  "version": 1,
  "id": "phase-8",
  "title": "Phase 8 — Shadow pass",
  "description": "Adversarial verification profile for the current Phase 8 architecture document.",
  "targets": [
    {
      "path": "docs/phase8/v1/PHASE_8_DOC.md",
      "role": "document under review",
      "selectors": [
        {
          "id": "whole_document",
          "selector": {
            "start": "^# Schmaloogium — Phase 8:"
          }
        }
      ]
    }
  ],
  "design_revision": {
    "target_index": 0,
    "section_zero": {
      "start": "^## 0\\. Header$",
      "end": "^## 1\\. Scope & boundaries$"
    },
    "declaration_pattern": "^\\*\\*Governing design:\\*\\* `(?<path>docs/design/[A-Za-z0-9._-]+/DESIGN\\.md)`"
  },
  "authoritative_sources": [
    {
      "path": "docs/design/{design_version}/DESIGN.md",
      "role": "governing design revision",
      "selectors": [
        {
          "id": "part_i",
          "selector": {
            "start": "^## Part I — Global sections$",
            "end": "^## Part II — Phase specifications$"
          }
        },
        {
          "id": "target_spec",
          "selector": {
            "start": "^### Phase 8 — Shadow pass$",
            "end": "^### Phase 9 — ID aliasing & per-draw dynamics$"
          }
        },
        {
          "id": "doc_gate",
          "selector": {
            "start": "^\\*\\*Doc gate:\\*\\* camera math written out \\(matrices, snapping formula\\); traversal algorithm$",
            "end": "^\\*\\*Impl gate:\\*\\*",
            "end_mode": "first-after-start"
          }
        },
        {
          "id": "mandatory_template",
          "selector": {
            "start": "^## G9\\. PHASE_X_DOC\\.md — mandatory template$",
            "end": "^## G10\\. Open-question assignments$"
          }
        }
      ]
    },
    {
      "path": "docs/research/v1/RESEARCH.md",
      "role": "contract ground truth"
    }
  ],
  "supporting_evidence": [
    {
      "path": "docs/reference/pintonium/v1.0/PINTONIUM_DESIGN.md",
      "role": "Pintonium shadow-pass evidence map"
    },
    {
      "path": "reference-src/pintonium-9c2fcc1/modern/src/main/shaders_java/net/irisshaders/iris/shadows/ShadowMatrices.java",
      "role": "Pintonium portable shadow projection and model-view math evidence"
    },
    {
      "path": "reference-src/pintonium-9c2fcc1/modern/src/main/shaders_java/net/irisshaders/iris/shadows/ModernShadowRenderer.java",
      "role": "Pintonium portable shadow camera and pass-order evidence"
    },
    {
      "path": "reference-src/pintonium-9c2fcc1/common-shaders/src/main/java/net/irisshaders/iris/shadows/CommonShadowRenderer.java",
      "role": "Pintonium celestial-angle convention evidence"
    },
    {
      "path": "reference-src/pintonium-9c2fcc1/common-shaders/src/main/java/net/irisshaders/iris/uniforms/CelestialUniforms.java",
      "role": "Pintonium celestial-vector convention evidence"
    },
    {
      "path": "reference-src/schlorbium-HD_U_G6_pre1/doc/shaders.txt",
      "role": "OptiFine shadow program, uniform, texture, buffer, and directive contract evidence"
    },
    {
      "path": "reference-src/schlorbium-HD_U_G6_pre1/SHADER_ENGINE_IMPL.md",
      "role": "OptiFine behavioral-observation digest for the shadow pass"
    },
    {
      "path": "reference-src/cleanroom-0.6.6-alpha/src/main/java/net/minecraftforge/client/ForgeHooksClient.java",
      "role": "Cleanroom Forge render-pass setter evidence"
    },
    {
      "path": "reference-src/cleanroom-0.6.6-alpha/src/main/java/net/minecraftforge/client/MinecraftForgeClient.java",
      "role": "Cleanroom Forge render-pass getter evidence"
    },
    {
      "path": "reference-src/cleanroom-0.6.6-alpha/patches/minecraft/net/minecraft/client/renderer/RenderGlobal.java.patch",
      "role": "Cleanroom pass-aware entity traversal evidence"
    }
  ],
  "dependencies": [
    {
      "path": "docs/phase4/v1/PHASE_4_DOC.md",
      "role": "dependency architecture and binding interface",
      "binding_contract": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      }
    },
    {
      "path": "docs/phase5/v1/PHASE_5_DOC.md",
      "role": "dependency architecture and binding interface",
      "binding_contract": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      }
    },
    {
      "path": "docs/phase6/v1/PHASE_6_DOC.md",
      "role": "dependency architecture and binding interface",
      "binding_contract": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      }
    },
    {
      "path": "docs/phase7/v1/PHASE_7_DOC.md",
      "role": "dependency architecture and binding interface",
      "binding_contract": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      }
    }
  ],
  "prior_reviews": {
    "directory": "docs/phase8/reviews",
    "filename_regex": "^PHASE_8_REVIEW_(?<round>\\d+)\\.md$",
    "round_group": "round",
    "read_order": "adjudicator-last",
    "allow_gaps": false
  },
  "forbidden_sources": {
    "path_patterns": [
      "docs/**/chatlogs/**",
      "*.txt"
    ],
    "provenance_patterns": [
      "any prior agent or session transcript, regardless of path or extension"
    ]
  },
  "immutable_paths": [
    "docs/research/**",
    "docs/design/**",
    "docs/reference/**",
    "docs/phase4/v1/PHASE_4_DOC.md",
    "docs/phase4/reviews/**",
    "docs/phase5/v1/PHASE_5_DOC.md",
    "docs/phase5/reviews/**",
    "docs/phase6/v1/PHASE_6_DOC.md",
    "docs/phase6/reviews/**",
    "docs/phase7/v1/PHASE_7_DOC.md",
    "docs/phase7/reviews/**",
    "docs/phase8/reviews/*.md",
    "reference-src/pintonium-9c2fcc1/modern/src/main/shaders_java/net/irisshaders/iris/shadows/ShadowMatrices.java",
    "reference-src/pintonium-9c2fcc1/modern/src/main/shaders_java/net/irisshaders/iris/shadows/ModernShadowRenderer.java",
    "reference-src/pintonium-9c2fcc1/common-shaders/src/main/java/net/irisshaders/iris/shadows/CommonShadowRenderer.java",
    "reference-src/pintonium-9c2fcc1/common-shaders/src/main/java/net/irisshaders/iris/uniforms/CelestialUniforms.java",
    "reference-src/schlorbium-HD_U_G6_pre1/doc/shaders.txt",
    "reference-src/schlorbium-HD_U_G6_pre1/SHADER_ENGINE_IMPL.md",
    "reference-src/cleanroom-0.6.6-alpha/src/main/java/net/minecraftforge/client/ForgeHooksClient.java",
    "reference-src/cleanroom-0.6.6-alpha/src/main/java/net/minecraftforge/client/MinecraftForgeClient.java",
    "reference-src/cleanroom-0.6.6-alpha/patches/minecraft/net/minecraft/client/renderer/RenderGlobal.java.patch"
  ],
  "write_permissions": {
    "adjudicator": [
      "{review_output}"
    ],
    "fixup": [
      "docs/phase8/v1/PHASE_8_DOC.md",
      "{review_output}"
    ]
  },
  "output": {
    "directory": "docs/phase8/reviews",
    "review_template": "PHASE_8_REVIEW_{round}.md",
    "journal_directory": ".verification-runs/phase-8"
  },
  "attack_lenses": "verification/lenses/phase-document.json",
  "lens_order": {
    "first_review": [
      "interfaces",
      "conformance",
      "doc-gate",
      "scope-decisions",
      "new-surface"
    ],
    "mature": [
      "new-surface",
      "interfaces",
      "conformance",
      "doc-gate",
      "scope-decisions"
    ]
  },
  "citation": {
    "format": "repo-relative-line-quote",
    "resolver": "line-quote",
    "allow_unique_relocation": true
  },
  "interface_regions": [
    {
      "id": "cross-phase-interfaces",
      "path": "docs/phase8/v1/PHASE_8_DOC.md",
      "selector": {
        "start": "^## 5\\. Cross-phase interfaces$",
        "end": "^## 6\\. Failure modes & degradation$"
      },
      "change_trigger": "A fresh verify round is required before Phase 8 can close."
    }
  ],
  "policy": "verification/policy.json",
  "target_context": {
    "assigned_open_questions": "none",
    "phase_name": "Shadow pass",
    "mandatory_section_count": 13
  },
  "fixup_instructions": "This is a first-version document with no mature fix-up-addendum convention. If a correction changes the target, add only a compact next-numbered §0 subsection using its existing header style; do not import Phase 1's supersession sentences, dated-claim ranges, or session-count bookkeeping. Keep full reasoning in the current review's Resolutions and do not roll the v1 directory during a loop."
}

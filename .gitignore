.gradle
**/build/
!src/**/build/
run/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea

# reference source code
reference-src

# session transcripts — kept on disk as evidence, out of history.
# The ignore rule is about repo size, not about the forbidden-source rule.
docs/**/chatlogs/

# vscode settings
.vscode/settings.json

# Eclipse language-server compiler output
/bin/
.omp/rules/java-completion-verification.md

# Mixin dev-flag export dir (enable_mixin_debug)
.mixin.out/

# IDE-generated class output (Eclipse/IntelliJ bin dirs)
engine/bin/
mod/bin/
conformance/bin/

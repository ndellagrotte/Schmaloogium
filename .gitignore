.gradle
**/build/
!src/**/build/
run/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea

# reference source code
reference-src

# session transcripts — kept on disk as evidence, out of history.
# NOTE: the /verify-loop harness bars agents from reading these; the ignore
# rule is about repo size, not about the forbidden-source rule.
docs/**/chatlogs/


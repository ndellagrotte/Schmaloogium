{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "verdict",
    "severity_should_be",
    "touches_interface",
    "strongest_refutation_attempted",
    "why_it_held_or_failed",
    "evidence",
    "recommended_fix"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["CONFIRMED", "OVERSTATED", "REFUTED"] },
    "severity_should_be": { "enum": ["blocking", "correction", "note", "none"] },
    "touches_interface": { "type": "boolean" },
    "strongest_refutation_attempted": { "type": "string", "minLength": 1 },
    "why_it_held_or_failed": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "recommended_fix": { "type": "string" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "quote", "shows"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "shows": { "type": "string", "minLength": 1 }
      }
    }
  }
}

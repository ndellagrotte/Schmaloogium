{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schmaloogium.local/schemas/verification-lens-set.schema.json",
  "title": "Verification attack lens set",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "lenses"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "instructions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "instructions": { "type": "string", "minLength": 1 },
          "first_review_instructions": { "type": "string" },
          "prior_resolution_access": { "type": "boolean" }
        }
      }
    }
  }
}
